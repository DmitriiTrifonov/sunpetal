{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/verify.sh quick >&2 || exit 2",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
